# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moon_guide

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Secret Key
SECRET_KEY=your-secret-key-here

# Embedding
EMBEDDING_PROVIDER=sentence-transformers  # "sentence-transformers" or "mistral"
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Mistral Embedding (set provider to "mistral" to use)
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_EMBEDDING_DIMENSION=1024
MISTRAL_EMBEDDING_BATCH_SIZE=32
MISTRAL_RATE_LIMIT_RPM=300

# Embedding Cache
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=86400

# pgAdmin Configuration
PGADMIN_EMAIL=admin@moonguide.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
