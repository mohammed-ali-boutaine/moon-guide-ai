# API URL (browser + server fallback)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only: where Next.js proxies uploads and /api/* (must be full http(s) URL).
# Local dev: http://localhost:8000  |  Docker frontend container: http://backend:8000
# Do not paste boolean keys from backend .env (e.g. PROMETHEUS_METRICS_ENABLED) here.
BACKEND_URL=http://localhost:8000

# App Configuration
NEXT_PUBLIC_APP_NAME=Moon Guide AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
